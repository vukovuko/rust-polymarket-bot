# REQUIRED — fill these in
PRIVATE_KEY=0xYOUR_KEY_HERE

# Risk limits
MAX_TRADE_USD=5
MAX_DAILY_EXPOSURE=20
KILL_SWITCH_LOSS=10

# Strategy
ARB_THRESHOLD=0.02
SPREAD_OFFSET=0.03

# API
POLY_API_URL=https://clob.polymarket.com
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Telegram alerts (get from @BotFather)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Weather strategy
EDGE_THRESHOLD=0.10
MIN_PROBABILITY=0.30
MAX_WEATHER_POSITION=10
MIN_ENTRY_PRICE=0.03
MAX_ENTRY_PRICE=0.65
WEATHER_SCAN_INTERVAL=1800
WEATHER_FAST_SCAN_INTERVAL=300

# Gaussian CDF tuning
STD_INFLATION=1.8
SLIPPAGE_ESTIMATE=0.02
APPLY_BIAS_CORRECTION=true

# Require live WS prices (skip stale Gamma prices for edge detection)
# Set to true when ready for live trading to avoid false edges
REQUIRE_WS_PRICE=false

# Kelly position sizing
BANKROLL=77
KELLY_FRACTION=0.25

# Mode (true = alert only, false = live trading)
ALERT_ONLY=true

# Logging
RUST_LOG=info
